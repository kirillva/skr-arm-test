{
  "name": "arm-autotests",
  "version": "0.1.0",
  "private": true,
  "description": "Автотесты АРМ (dev): авторизация, RBAC, API-контракты",
  "scripts": {
    "test": "playwright test",
    "test:auth": "playwright test --grep @auth",
    "test:api": "playwright test --grep @api",
    "test:rbac": "playwright test --grep @rbac",
    "test:smoke": "playwright test --grep \"@smoke\"",
    "report": "playwright show-report",
    "codegen": "playwright codegen https://skr.it-serv.ru/arm/dev/#/auth"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "dotenv": "^18.0.9",
    "typescript": "^7.0.2"
  }
}
